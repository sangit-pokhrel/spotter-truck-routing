# Copy to deploy/.env on the VPS (never commit the real file).

# Hostname people use to reach the app: a domain/subdomain, or the server's IP for quick tests.
DOMAIN=truck.example.com
DJANGO_SECRET_KEY=change-me
# Long random value: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# Port
# The app listens on this host port; 80/443 are left to the server's other services.
APP_PORT=8563
# 0.0.0.0: reachable at http://SERVER:8563 (quick tests, no HTTPS).
# 127.0.0.1: only via your reverse proxy on this server (recommended with HTTPS, see nginx-site.conf).
APP_BIND=0.0.0.0
# Proxies in front of the app: 1 behind nginx/Caddy, 0 when browsers connect to APP_PORT directly.
TRUSTED_PROXIES=0

# HTTPS
# Phones need HTTPS for GPS, notifications, offline mode and "Install app". Either:
#  a) point the reverse proxy already on 80/443 at APP_PORT (deploy/nginx-site.conf), or
#  b) on a server where 80/443 are FREE, use the bundled Caddy: add "https" to COMPOSE_PROFILES.
# COMPOSE_PROFILES=https
# ACME_EMAIL=you@example.com

# Image (IMAGE_TAG is rewritten by deploy.sh on every release)
IMAGE=ghcr.io/sangit-pokhrel/spotter-truck-routing
IMAGE_TAG=latest

WEB_CONCURRENCY=2
API_RATE_LIMIT=120/min
# auto: fetch weather on the server (the VPS has its own IP), fall back to the browser if throttled.
WEATHER_SOURCE=auto
# Optional commercial Open-Meteo key (no rate limits at all).
OPEN_METEO_API_KEY=

# Optional self-hosted Valhalla (posted speed limits without public rate limits)
# Add "valhalla" to COMPOSE_PROFILES (comma-separated, e.g. COMPOSE_PROFILES=valhalla or https,valhalla).
# Pick extracts that cover your routes and that your RAM can build: https://download.geofabrik.de
# VALHALLA_URL=http://valhalla:8002
# SPEED_LIMITS_PARALLEL=6
# VALHALLA_PBF_URLS=https://download.geofabrik.de/north-america/us/colorado-latest.osm.pbf https://download.geofabrik.de/north-america/us/nebraska-latest.osm.pbf
