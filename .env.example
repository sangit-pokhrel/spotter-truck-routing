# Backend (all optional for local development)
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Shared cache across workers/instances (otherwise per-process memory cache)
REDIS_URL=
# Providers (defaults are free, keyless public endpoints)
OSRM_URL=https://router.project-osrm.org
PHOTON_URL=https://photon.komoot.io
OPEN_METEO_API_KEY=
# auto (server, falls back to browser fetch when rate-limited) | server | client
WEATHER_SOURCE=auto
# Truck governed (top) speed; posted limits above it are driven at this speed
TRUCK_MAX_SPEED_MPH=65
# Posted speed limits in ETAs (Valhalla); set VALHALLA_URL to a self-hosted instance in production
SPEED_LIMITS_ENABLED=true
VALHALLA_URL=https://valhalla1.openstreetmap.de
WEATHER_CACHE_TTL_S=1800
API_RATE_LIMIT=120/min

# Frontend (Vite, build-time)
# Only needed when the API is hosted on a different origin than the SPA.
VITE_API_URL=
VITE_TILE_URL=
